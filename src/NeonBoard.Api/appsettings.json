{
    "Auth0": {
        "Domain": "neonboard.us.auth0.com",
        "Audience": "https://nb.neonboard.app"
    },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "Microsoft.EntityFrameworkCore": "Warning",
        "System": "Warning"
      }
    }
  },
  "AllowedHosts": "*",
  "RateLimitSettings": {
    "AuthenticatedPermitLimit": 100,
    "AnonymousPermitLimit": 20,
    "WindowInSeconds": 60
  }
}
